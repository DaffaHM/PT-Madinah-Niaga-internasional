# ─── Environment Variables untuk Production ───────────────────────────────
# Salin file ini menjadi .env.production atau set langsung di cPanel
# Environment Variables manager

# URL publik website (wajib diisi, tanpa trailing slash)
NEXT_PUBLIC_SITE_URL=https://madinahniaga.com

# Node environment — selalu "production" di server
NODE_ENV=production

# Port yang digunakan Node.js App di cPanel
# cPanel biasanya assign port otomatis via variabel PORT
# Jika tidak, set manual sesuai port yang diberikan cPanel
PORT=3000
